package {{.Name}}

import (
	"github.com/gofiber/fiber/v3"

	"{{.ModulePath}}/internal/server"
)

// Feature wires together all {{.Name}} components.
type Feature struct {
	Handler *Handler
}

// NewModule creates the {{.Name}} feature with its dependencies.
// Repo only needs db; service gets redis/minio (nil if not configured) —
// service decides whether to use them, repo knows nothing about them.
func NewModule(deps server.Deps) *Feature {
	repo := NewRepository(deps.DB)
	svc := NewService(repo, deps.Redis, deps.Minio)
	return &Feature{Handler: NewHandler(svc)}
}

// RegisterRoutes attaches {{.Name}} routes to the given router.
func (f *Feature) RegisterRoutes(router fiber.Router) {
{{- if .CRUD}}
	g := router.Group("/{{.Name}}")
	g.Get("/", f.Handler.List)
	g.Get("/:id", f.Handler.Get)
	g.Post("/", f.Handler.Create)
	g.Put("/:id", f.Handler.Update)
	g.Delete("/:id", f.Handler.Delete)
{{- else}}
	// TODO: register {{.Name}} routes here
{{- end}}
}
